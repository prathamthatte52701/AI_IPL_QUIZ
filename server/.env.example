# Server
CLIENT_URL=https://ai-ipl-quiz.onrender.com/

# Gemini API - get key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cricket API - CricAPI / CricketData.org
# App works without this key using demo-live IPL fallback data.
CRICKET_API_KEY=
CRICKET_API_BASE=https://api.cricapi.com/v1
CRICKET_REFRESH_MS=10000
ENABLE_DEMO_LIVE_DATA=true

# Quiz rules
QUESTION_TIME_SECONDS=15
MAX_QUESTIONS=5
MAX_PLAYERS=4
AUTH_TOKEN_SECRET=